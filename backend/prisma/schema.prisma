// CRM Automotivo - Schema do módulo de Atendimento (Tickets)
//
// Convenções:
//  - PKs em cuid() (exceto Ticket.number, sequencial e amigável para humanos).
//  - `platform` é uma String (slug do adapter em src/integrations), não um enum:
//    adicionar uma nova plataforma NÃO exige migration.
//  - Dados pessoais do lead (PII) ficam concentrados em `leads`, preparados
//    para anonimização (LGPD - direito ao esquecimento).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Nível base do usuário. Depois da introdução dos perfis de acesso
/// (`AccessProfile`) ele NÃO decide mais o que o usuário pode fazer - quem
/// decide é a lista de permissões do perfil. Continua existindo por dois
/// motivos: é o fallback de quem ainda não tem perfil (bases antigas) e é o
/// que responde "quem é administrador desta loja?" para quem não pergunta por
/// permissão - o aviso de expiração de trial, por exemplo. É derivado do
/// perfil na escrita (ver roleFromPermissions), nunca editado à mão.
enum UserRole {
  ADMIN
  AGENT
}

/// Ciclo de vida da conta contratante (tenant). É o portão de acesso efetivo:
/// somente TRIAL e ACTIVE liberam o uso; os demais bloqueiam o login/rotas.
enum AccountStatus {
  TRIAL // período gratuito em andamento
  ACTIVE // assinatura paga ativa
  PAST_DUE // inadimplente (cobrança falhou) - bloqueia
  SUSPENDED // suspensa manualmente pelo operador - bloqueia
  EXPIRED // trial/assinatura vencido - bloqueia (dados preservados)
  CANCELED // cancelada pelo cliente - bloqueia
}

/// Estado de billing da assinatura (espelha o gateway quando integrado).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Periodicidade da cobrança. O anual cobra 10 mensalidades (2 meses grátis) -
/// desconto que existe para antecipar caixa e derrubar churn, e é o que
/// justifica liberar boleto.
enum BillingCycle {
  MONTHLY
  YEARLY
}

/// Meio de pagamento da assinatura.
///
/// CREDIT_CARD é o único que renova sozinho e por isso é o padrão empurrado.
/// PIX gera cobrança a cada ciclo (exige ação do cliente - risco de churn
/// passivo). BOLETO fica restrito ao ciclo anual (ver plans.ts): boleto mensal
/// em SaaS pequeno é máquina de inadimplência e trabalho manual.
enum BillingMethod {
  CREDIT_CARD
  PIX
  BOLETO
}

/// Ciclo de vida de UMA cobrança no gateway. Espelha os estados do Asaas -
/// PENDING (emitida), CONFIRMED (paga, ainda não liquidada), RECEIVED
/// (dinheiro na conta), OVERDUE (vencida) e os desfechos negativos.
enum ChargeStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  CANCELED
  CHARGEBACK
  FAILED
}

/// Estágio do processamento de um evento recebido do gateway.
enum BillingEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Métricas de consumo medidas por conta e por ciclo.
///
/// Existem porque o plano é flat mas o custo destes itens é variável: uma loja
/// com muito volume de chat pode queimar mais em tokens do que paga. Sem
/// medição não há como aplicar cota nem cobrar excedente.
enum UsageMetric {
  AI_MESSAGE
  CREDIT_QUERY
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  CONVERTED
  LOST
  ARCHIVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InteractionType {
  CUSTOMER_MESSAGE // mensagem recebida do lead (via plataforma ou registro manual)
  AGENT_REPLY // resposta enviada pelo atendente
  INTERNAL_NOTE // nota interna, invisível ao cliente
  STATUS_CHANGE // registro de mudança de status na linha do tempo
  ASSIGNMENT // registro de (re)atribuição na linha do tempo
  SYSTEM // eventos automáticos
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum IntegrationStatus {
  AVAILABLE // ainda não conectada
  CONNECTED // credenciais válidas, operando
  AUTH_ERROR // credenciais rejeitadas na última verificação
  DISABLED // conectada, porém pausada pelo admin
}

enum VehicleType {
  CAR
  MOTORCYCLE
  HEAVY // pesados (caminhões/ônibus)
}

enum VehicleSaleStatus {
  PREPARING // em preparação (oficina/estética)
  AVAILABLE // disponível para venda
  RESERVED // reservado
  SOLD // vendido
  CONSIGNED // consignado (não é da loja)
}

enum DispatchStatus {
  SENT
  FAILED
  SKIPPED // sync desativada ou integração não conectada
}

enum CreditDocType {
  CPF
  CNPJ
}

enum FinancialType {
  PAYABLE // conta a pagar (despesa)
  RECEIVABLE // conta a receber (faturamento)
}

enum FinancialStatus {
  PENDING
  PAID
  // "OVERDUE" (atrasado) é derivado: PENDING + dueDate < hoje
}

enum FiscalKind {
  NFE_ENTRY // NF-e de entrada (compra de veículo de PF)
  NFE_EXIT // NF-e de saída (venda definitiva)
  NFE_RETURN // NF-e de devolução (retirada de consignado)
  NFSE // NFS-e (comissão de intermediação / serviços de oficina)
}

enum FiscalStatus {
  PROCESSING
  AUTHORIZED
  CANCELED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Conta (tenant) à qual o usuário pertence. Nullable apenas por compatibilidade
  /// de migração; a aplicação sempre popula (backfill dos usuários pré-SaaS numa
  /// conta default). Todo novo usuário herda o accountId de quem o cria.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  /// Perfil de acesso (o que este usuário pode fazer). Nullable por
  /// compatibilidade: usuário sem perfil cai no fallback do `role` acima.
  /// `onDelete: SetNull` é conservador de propósito - apagar um perfil nunca
  /// pode apagar gente; a rota de exclusão já barra perfis em uso.
  profileId String?
  profile   AccessProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  assignedTickets  Ticket[]            @relation("TicketAssignee")
  interactions     TicketInteraction[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  creditQueries    CreditQuery[]
  channels         UserChannel[]
  termsAcceptances TermsAcceptance[]

  @@index([accountId])
  @@index([profileId])
  @@map("users")
}

/// Perfil de acesso (o "cargo" dentro da loja): um nome e a lista de
/// permissões que ele concede. Pertence a UMA conta - cada lojista desenha os
/// próprios perfis, e nenhum enxerga os do vizinho.
///
/// Por que uma tabela e não um enum: o conjunto de cargos de uma loja de
/// veículos não é fechado (avaliador, gerente de F&I, financeiro, estagiário
/// de vendas...). Um enum exigiria migration a cada cargo novo e ainda deixaria
/// o lojista sem poder afinar o que cada um vê.
///
/// `permissions` guarda os slugs do catálogo (src/modules/roles/permissions.ts).
/// O perfil de administrador guarda o coringa `*`: assim ele já nasce com toda
/// permissão que o produto vier a ganhar, sem depender de backfill.
model AccessProfile {
  id          String  @id @default(cuid())
  name        String
  description String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Chave estável dos perfis criados junto com a conta ('admin', 'agent').
  /// Perfis criados pelo lojista têm `null`. É por ela que o código reencontra
  /// o perfil padrão sem depender do nome, que o lojista pode ter mudado.
  systemKey String?

  /// Slugs do catálogo de permissões, ou `*` (acesso total).
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  /// Dois perfis com o mesmo nome na mesma loja viram armadilha na hora de
  /// atribuir alguém - o banco impede.
  @@unique([accountId, name])
  @@unique([accountId, systemKey])
  @@index([accountId])
  @@map("access_profiles")
}

/// Canal de atendimento conectado por UM atendente (hoje: WhatsApp Cloud API).
///
/// Existe separado de `Integration` porque as duas pontas do WhatsApp têm donos
/// diferentes: a conta WhatsApp Business (WABA) é da LOJA e o admin a conecta em
/// Integrações, enquanto o NÚMERO que fala com o cliente é de cada atendente e
/// mora aqui. Sem essa separação, as respostas de todos sairiam pelo mesmo
/// número e o cliente perderia a referência de com quem estava falando.
///
/// Não guarda credencial: o token de acesso é da WABA e vive cifrado em
/// `Integration.credentials`. O que identifica o número na API da Meta é o
/// `externalId` (phoneNumberId), que não é segredo.
model UserChannel {
  id       String @id @default(cuid())
  platform String // slug do adapter (hoje só 'whatsapp')

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tenant dono do canal. Redundante com user.accountId por decisão: o unique
  /// abaixo precisa dele para impedir que duas lojas reivindiquem o mesmo número.
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Identificador do número na plataforma (Cloud API: phoneNumberId).
  externalId    String
  /// Número como a Meta o exibe (ex.: "+55 84 98801-3786") - só para a tela.
  displayNumber String
  /// Nome verificado do remetente exibido ao cliente no WhatsApp.
  verifiedName  String?

  connectedAt   DateTime  @default(now())
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Um número atende por UMA caixa: se dois atendentes registrassem o mesmo
  /// phoneNumberId, a resposta sairia pelo mesmo remetente e o roteamento de
  /// entrada ficaria ambíguo.
  @@unique([accountId, platform, externalId])
  /// Um atendente tem no máximo um número por plataforma.
  @@unique([userId, platform])
  @@index([accountId, platform])
  @@map("user_channels")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 do token - o valor bruto nunca é persistido
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Interessado/cliente em potencial. Contém PII - tratar conforme LGPD:
/// nunca logar em texto claro; anonimizável via anonymizedAt.
model Lead {
  id           String    @id @default(cuid())
  name         String
  phone        String? // somente dígitos, normalizado na ingestão
  email        String?
  platform     String // slug da plataforma de origem (olx, mercadolivre, webmotors, manual)
  externalId   String? // id do lead na plataforma de origem - chave de deduplicação
  anonymizedAt DateTime? // LGPD: preenchido quando o titular exerce o direito ao esquecimento
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Tenant dono do lead - fronteira de privacidade do SaaS. Sem ele, o mesmo
  /// titular contatando duas lojas viraria UM registro compartilhado entre elas.
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  document String? // CPF/CNPJ do cliente (dígitos) - usado na consulta rápida
  extra    Json? // campos personalizados do formulário (config em Setting "leadForm")

  /// Consentimento do titular para consulta de crédito (LGPD art. 7º, I) - ver
  /// legal/09-CONSENTIMENTO-CONSULTA-DE-CREDITO.md. Vale para a consulta mais
  /// recente: cada nova consulta regrava os três campos, inclusive quando é o
  /// próprio agente de IA que a colhe (fornecida voluntariamente pelo titular
  /// no chat). `creditConsentSource` é o canal ('presencial', 'whatsapp',
  /// 'site', 'telefone', 'chat_ia' ou o slug da plataforma de origem).
  creditConsentAt      DateTime?
  creditConsentSource  String?
  creditConsentVersion String?

  /// Perfil de compra coletado pelo agente ao longo da conversa (orçamento, carro
  /// na troca, forma de pagamento, urgência, preferências). Vai no prefixo do
  /// prompt para o agente parar de reperguntar o que já foi respondido.
  /// É PII de preferência comercial - segue as mesmas regras de anonimização.
  profile Json?

  tickets       Ticket[]
  creditQueries CreditQuery[]

  /// Dedup por conta: o mesmo externalId em lojas diferentes são leads distintos.
  @@unique([accountId, platform, externalId])
  @@index([accountId, phone])
  @@index([accountId, email])
  @@index([accountId, name])
  @@map("leads")
}

model Ticket {
  id       String         @id @default(cuid())
  number   Int            @unique @default(autoincrement()) // exibição: #123
  leadId   String
  lead     Lead           @relation(fields: [leadId], references: [id])
  status   TicketStatus   @default(NEW)
  priority TicketPriority @default(NORMAL)

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  /// Tenant dono do atendimento. Todo acesso a ticket é filtrado por ele ANTES
  /// da regra de papel (ver scopeFor em tickets.service.ts).
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  platform String // origem do ticket (slug)
  campaign String? // campanha/mídia, quando a plataforma informa

  /// Agente de Pré-Venda IA ("bot_ativo"): quando true, mensagens recebidas do
  /// lead nesta conversa são respondidas automaticamente pelo Claude. O bot se
  /// desliga (false) ao transferir para um humano ou quando o atendente assume.
  botEnabled Boolean @default(false) @map("bot_enabled")

  /// Referência flexível ao veículo de interesse (o módulo de Estoque ainda não existe).
  /// Formato: { externalId?, title?, price?, url?, ...extras da plataforma }.
  /// Migração futura planejada (ver README): adicionar `vehicleId` FK para `vehicles`,
  /// fazer backfill a partir deste JSON e manter este campo como registro de origem.
  vehicleRefExternal Json? @map("vehicle_ref_external")

  firstResponseAt       DateTime? // base do SLA de primeira resposta (calculado na API)
  lastCustomerMessageAt DateTime?
  closedAt              DateTime?

  /// Relógio do motor de fluxo. Em vez de uma tabela de jobs agendados, o próprio
  /// ticket carrega QUANDO a próxima ação vence; o worker consulta um índice em
  /// `nextActionAt`. Trocar a política passa a valer na hora, para todos os
  /// tickets, sem reescrever linhas agendadas.
  nextActionAt   DateTime?
  followUpCount  Int       @default(0)
  lastFollowUpAt DateTime?
  /// Por que fechou (ex.: "sem_resposta"), quando o fechamento foi automático.
  closeReason    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  interactions TicketInteraction[]

  @@index([accountId, status])
  /// Consulta do motor de fluxo: "o que venceu?" - parcial na prática, já que a
  /// maioria dos tickets tem nextActionAt nulo.
  @@index([nextActionAt])
  @@index([accountId, assignedToId])
  @@index([accountId, platform])
  @@index([accountId, createdAt])
  @@index([leadId])
  @@map("tickets")
}

/// Linha do tempo do ticket: mensagens, respostas, notas e eventos.
model TicketInteraction {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      InteractionType
  authorId  String? // null para mensagens do lead e eventos de sistema
  author    User?           @relation(fields: [authorId], references: [id])
  body      String?
  metadata  Json? // ex.: { from, to } em mudanças de status/atribuição
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_interactions")
}

/// Trilha de auditoria genérica - base dos relatórios futuros de performance
/// (tempo por status, reatribuições, conversão por vendedor).
model AuditLog {
  id         String   @id @default(cuid())
  entityType String // ex.: TICKET, LEAD
  entityId   String
  action     String // CREATED, STATUS_CHANGED, ASSIGNED, PRIORITY_CHANGED, LEAD_ANONYMIZED...
  actorId    String? // null quando a ação veio de integração/sistema
  actor      User?    @relation(fields: [actorId], references: [id])
  data       Json? // detalhes: { from, to, via, ... }
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

/// Evento bruto recebido pelo serviço de webhooks. Persistido ANTES de qualquer
/// processamento (fila em banco): picos ou payloads inválidos nunca perdem dados.
/// O worker (src/workers/lead-processor.ts) consome, normaliza via adapter e
/// cria/atualiza tickets, com retry e backoff.
model WebhookEvent {
  id            String             @id @default(cuid())
  platform      String
  payload       Json
  status        WebhookEventStatus @default(RECEIVED)
  attempts      Int                @default(0)
  nextAttemptAt DateTime? // backoff entre tentativas
  lastError     String?
  ticketId      String? // preenchido após processamento (sem FK, acoplamento fraco)
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?

  /// Conta resolvida já na RECEPÇÃO, pela webhookKey da URL. O worker só
  /// processa o que já chegou carimbado - nunca precisa adivinhar o tenant.
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, receivedAt])
  @@index([accountId, receivedAt])
  @@map("webhook_events")
}

/// Estado de conexão de uma plataforma PARA UMA CONTA no Módulo de Integrações.
/// Uma linha por (conta, plataforma): cada lojista conecta a própria conta da
/// OLX/ML/Webmotors, com credenciais próprias. As credenciais de API e o segredo
/// de webhook ficam CIFRADOS em repouso (AES-256-GCM, ver src/lib/crypto.ts) -
/// o valor bruto nunca trafega de volta para o front (a API devolve máscara).
model Integration {
  id            String            @id @default(cuid())
  platform      String // slug do adapter (olx, mercadolivre, ...)
  status        IntegrationStatus @default(AVAILABLE)
  syncEnabled   Boolean           @default(true) // sincronização de mensagens (in/out)
  credentials   Json? // { iv, tag, data } - payload cifrado; nunca em texto claro
  accountLabel  String? // rótulo da conta conectada (retornado pela validação)
  connectedAt   DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Identificador OPACO que roteia o webhook até esta conta:
  ///   POST /webhooks/:platform/:webhookKey
  /// Não é credencial - quem autentica é `inboundSecret`. Existe porque a URL
  /// precisa dizer de qual loja é o lead ANTES de qualquer verificação, e
  /// descobrir isso testando o segredo contra todas as contas seria O(n) e
  /// vulnerável a timing attack.
  webhookKey String @unique

  /// Segredo que a plataforma envia no header (token ou chave HMAC), próprio de
  /// cada loja. Cifrado; { iv, tag, data }. Substitui os antigos
  /// OLX_WEBHOOK_TOKEN / MERCADOLIVRE_WEBHOOK_SECRET / WEBMOTORS_WEBHOOK_TOKEN,
  /// que eram únicos para toda a instalação.
  inboundSecret Json?

  dispatches IntegrationDispatch[]

  @@unique([accountId, platform])
  @@map("integrations")
}

/// Log de mensagens enviadas do CRM de volta para a plataforma (fluxo OUTBOUND).
/// Alimenta a área de "fluxo visualizado" da tela de integrações.
model IntegrationDispatch {
  id            String         @id @default(cuid())
  integrationId String
  integration   Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  platform      String
  ticketId      String?
  interactionId String?
  status        DispatchStatus
  detail        String? // resumo sem PII (ex.: "reply enviado", motivo do skip/erro)
  externalRef   String? // id retornado pela plataforma no envio
  createdAt     DateTime       @default(now())

  @@index([platform, createdAt])
  @@map("integration_dispatches")
}

/// Módulo de Análise de Crédito & Bureau - consultas de score/restrições por CPF/CNPJ.
/// `report` guarda o snapshot completo do diagnóstico no momento da consulta
/// (histórico auditável). O documento é armazenado só em dígitos (PII - nunca logar).
model CreditQuery {
  id       String        @id @default(cuid())
  document String // somente dígitos (CPF 11 / CNPJ 14)
  docType  CreditDocType
  name     String
  score    Int // 0..1000
  report   Json // snapshot completo do diagnóstico

  /// Tenant dono da consulta. Até aqui era a ÚNICA tabela de dado de negócio
  /// sem isolamento: consultas de todas as lojas (CPF/CNPJ + score) ficavam no
  /// mesmo balde, visíveis entre contas. Backfill: herda do lead vinculado ou
  /// da conta de quem consultou (ver migration).
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  actorId String? // quem realizou a consulta
  actor   User?   @relation(fields: [actorId], references: [id])
  /// Nullable só por compatibilidade com linhas anteriores à exigência de
  /// consentimento. Toda consulta NOVA é obrigada a informar um lead (ver
  /// credit.service.ts) - é nele que mora o registro de consentimento do
  /// titular, e sem lead não há como provar que a consulta foi autorizada.
  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id])

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, document])
  @@map("credit_queries")
}

/// Configurações da aplicação (chave → JSON). Ex.: "company" (dados da loja),
/// "leadForm" (quais campos do cadastro de leads são visíveis/obrigatórios).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// SaaS MULTI-TENANT - Contas, Planos, Assinaturas e Trial
// ─────────────────────────────────────────────────────────────────────────────

/// Catálogo de planos comercializáveis.
model Plan {
  id           String  @id @default(cuid())
  code         String  @unique // slug estável: 'trial', 'pro', 'business'
  name         String
  priceCents   Int     @default(0) // mensalidade em centavos (BRL)
  durationDays Int? // null = recorrente mensal; trial = 15
  features     Json    @default("{}") // ver PlanFeatures em modules/billing/plans.ts
  active       Boolean @default(true)

  /// Preço do ciclo ANUAL, cobrado de uma vez. Null = plano não é vendido no
  /// anual (o trial, por exemplo). Guardado explícito em vez de calculado:
  /// o desconto é decisão comercial e muda sem mexer em código.
  priceYearlyCents Int?

  /// Texto de venda mostrado no cartão do plano, e ordem/destaque na vitrine
  /// de planos dentro da Administração.
  description String?
  sortOrder   Int     @default(0)
  highlight   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts      Account[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Empresa contratante = tenant. É a raiz de isolamento do SaaS: no retrofit,
/// toda tabela de dado de cliente ganha `accountId` referenciando esta conta.
model Account {
  id     String        @id @default(cuid())
  name   String // razão social / nome fantasia da loja
  cnpj   String? // somente dígitos (opcional no trial)
  status AccountStatus @default(TRIAL)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  trialStartedAt   DateTime?
  trialEndsAt      DateTime? // trialStartedAt + 15 dias
  expiryNotifiedAt DateTime? // evita reenviar o aviso de pré-expiração

  /// Cliente correspondente no gateway de pagamento (Asaas: `cus_...`).
  ///
  /// Mora na CONTA, e não na assinatura, de propósito: o cadastro do pagador
  /// sobrevive a cancelamentos e trocas de plano. Recriar o cliente a cada
  /// assinatura duplicaria o pagador no painel do gateway e perderia o
  /// histórico de cobranças dele.
  gatewayCustomerId String?

  /// Dados de faturamento do pagador. Preenchidos na primeira assinatura; o
  /// CNPJ cai para `Account.cnpj` quando não informado à parte.
  billingName  String?
  billingEmail String?
  billingPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  profiles         AccessProfile[]
  subscription     Subscription?
  trialCpf         TrialCpfRegistry?
  vehicles         Vehicle[]
  storefront       Storefront?
  userChannels     UserChannel[]
  // Isolamento do atendimento: cada conta enxerga só o próprio funil.
  leads            Lead[]
  tickets          Ticket[]
  webhookEvents    WebhookEvent[]
  integrations     Integration[]
  // Agente de IA e automação de atendimento, configuráveis por lojista.
  agentProfile     AgentProfile?
  knowledgeDocs    KnowledgeDoc[]
  flowPolicy       FlowPolicy?
  // Pagamentos: cobranças emitidas, eventos do gateway e consumo medido.
  charges          BillingCharge[]
  billingEvents    BillingEvent[]
  usageCounters    UsageCounter[]
  creditQueries    CreditQuery[]
  termsAcceptances TermsAcceptance[]

  @@index([status])
  @@index([trialEndsAt])
  @@index([gatewayCustomerId])
  @@map("accounts")
}

/// Persona e limites do Agente de Pré-Venda, POR LOJA.
///
/// Antes existia um único system prompt fixo no código, que dizia "loja de
/// veículos premium" para toda conta. Num SaaS multi-loja isso é errado duas
/// vezes: o tom não é da loja e as regras comerciais (o que pode prometer sobre
/// preço, prazo, garantia) variam de lojista para lojista.
model AgentProfile {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  enabled   Boolean @default(true)
  /// Como o agente se apresenta ("a Washington Veículos"). Sem valor, usa o nome da conta.
  storeName String?
  /// Tom e estilo em uma ou duas frases ("consultivo e direto, sem formalidade excessiva").
  persona   String?
  /// Regras comerciais próprias da loja, em texto livre - entram no prompt como invioláveis.
  rules     String?

  /// Capacidades ligáveis. Desligar remove a ferramenta do agente, não só a menção
  /// no prompt: o modelo não pode chamar o que não recebe.
  canSearchInventory Boolean @default(true)
  canQuoteCredit     Boolean @default(true)
  canScheduleVisit   Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("agent_profiles")
}

/// Base de conhecimento da loja (garantia, financiamento, troca, horários...).
///
/// Estratégia de uso, decidida em tempo de execução pelo tamanho do corpus:
///  - corpus pequeno (o caso normal de uma loja): TODOS os documentos entram no
///    prefixo cacheado do system prompt. O modelo vê tudo, sem chunking e sem o
///    modo de falha clássico do RAG (o trecho certo não ser recuperado);
///  - corpus grande: a injeção é trocada por recuperação sob demanda via a
///    ferramenta `consultar_conhecimento`, que hoje usa busca textual do Postgres.
///
/// `embedding` fica reservado para quando/se a busca vetorial (pgvector) valer a
/// pena - a interface da ferramenta não muda, só o corpo da busca.
model KnowledgeDoc {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  title     String
  content   String
  enabled   Boolean @default(true)
  /// Reservado para busca vetorial futura; nulo enquanto a recuperação for lexical.
  embedding Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, enabled])
  @@map("knowledge_docs")
}

/// Automação de tempo do atendimento (follow-up e encerramento), POR LOJA.
///
/// `enabled` nasce FALSE de propósito: mandar mensagem automática para cliente é
/// ação externa e irreversível. Ligar isso para todas as contas numa migration
/// faria o sistema começar a falar com clientes sem ninguém ter pedido.
model FlowPolicy {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  /// Minutos de silêncio DO CLIENTE até cada follow-up, em ordem. O tamanho da
  /// lista é o número máximo de tentativas.
  followUpDelaysMin Json @default("[30, 240, 1440]")
  /// Silêncio total até encerrar como perdido (minutos). 4320 = 72 h.
  autoCloseAfterMin Int  @default(4320)

  /// Janela de silêncio: nada é enviado entre quietHoursStart e quietHoursEnd
  /// (hora local da loja). Follow-up às 3 da manhã destrói a conversa.
  quietHoursStart  Int     @default(20)
  quietHoursEnd    Int     @default(8)
  timezone         String  @default("America/Sao_Paulo")
  businessDaysOnly Boolean @default(false)

  /// SLA de primeira resposta HUMANA (minutos). Era env global; vira por conta.
  /// Este é o outro ramo do fluxo: aqui quem está devendo resposta é a loja,
  /// então a ação é alertar a equipe - nunca cutucar o cliente.
  slaFirstResponseMin Int @default(30)

  /// "ai" gera a mensagem a partir da conversa; "template" usa texto fixo.
  followUpMode String @default("ai")

  updatedAt DateTime @updatedAt

  @@map("flow_policies")
}

/// Vitrine pública (landing page) da conta - um site por lojista, alimentado
/// pelo próprio estoque. O endereço é o subdomínio derivado do `slug`
/// (washington-veiculos.eixo.com.br); `/loja/:slug` funciona sempre, para
/// desenvolvimento e pré-visualização.
///
/// `config` é JSON pela mesma razão de `settings`: a vitrine ganha campos novos
/// (seções, cores, textos) sem exigir migration. O shape é validado e
/// preenchido com defaults em modules/storefront/storefront.service.ts.
model Storefront {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  slug      String  @unique
  published Boolean @default(false)
  config    Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("storefronts")
}

/// Assinatura da conta (1:1). É o espelho local do contrato recorrente que vive
/// no gateway (Asaas): quem move dinheiro, retenta cartão e roda a régua de
/// inadimplência é ele; aqui guardamos o estado que o produto precisa consultar
/// sem ir à rede, e o vínculo para reconciliar por webhook.
model Subscription {
  id        String             @id @default(cuid())
  accountId String             @unique
  account   Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(TRIALING)

  cycle  BillingCycle  @default(MONTHLY)
  method BillingMethod @default(CREDIT_CARD)

  /// Preço TRAVADO no ato da contratação, em centavos. O catálogo pode subir de
  /// preço amanhã sem reajustar quem já assinou - reajuste é ato explícito
  /// (cláusula de IPCA no contrato), nunca efeito colateral de editar o plano.
  priceCents Int @default(0)

  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime? // fim do ciclo pago vigente
  nextDueDate      DateTime? // vencimento da próxima cobrança, segundo o gateway
  canceledAt       DateTime?

  /// Cancelamento agendado: o acesso continua até o fim do período já pago.
  cancelAtPeriodEnd Boolean @default(false)

  /// Vínculo com o gateway. `gateway` é o slug do provedor ('asaas') para que
  /// uma eventual troca não exija adivinhar a origem dos ids antigos.
  gateway                String?
  externalSubscriptionId String?

  /// Cartão em uso - apenas o que o gateway devolve para EXIBIÇÃO. O número do
  /// cartão nunca entra neste banco (tokenização do lado do gateway mantém a
  /// operação fora do escopo pesado de PCI-DSS).
  cardBrand  String?
  cardLast4  String?
  cardHolder String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges BillingCharge[]

  @@index([externalSubscriptionId])
  @@map("subscriptions")
}

/// Uma cobrança emitida pelo gateway (mensalidade, anuidade ou avulsa).
///
/// É a "fatura" que o lojista vê em Administração › Pagamentos: espelho local
/// do objeto `payment` do Asaas, reconciliado por webhook. Nada aqui é fonte da
/// verdade sobre dinheiro - a fonte é o gateway; esta tabela existe para a tela
/// abrir instantânea e para haver histórico auditável mesmo se a API cair.
model BillingCharge {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// id da cobrança no gateway (Asaas: `pay_...`). Único: é a chave de
  /// reconciliação que torna o processamento de webhook idempotente.
  gateway    String @default("asaas")
  externalId String @unique

  status      ChargeStatus  @default(PENDING)
  method      BillingMethod
  amountCents Int
  description String?

  dueDate DateTime
  paidAt  DateTime?

  /// Links prontos do gateway - a fatura web (serve para cartão e PIX), o PDF
  /// do boleto e o comprovante. O QR do PIX NÃO é guardado: é buscado sob
  /// demanda, porque tem validade e pesa como base64 no banco.
  invoiceUrl  String?
  bankSlipUrl String?
  receiptUrl  String?

  /// Nota fiscal de serviço emitida pelo gateway junto da cobrança.
  nfseStatus String?
  nfseUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, dueDate])
  @@index([status])
  @@map("billing_charges")
}

/// Caixa de entrada dos webhooks do gateway.
///
/// Mesmo princípio da fila de leads: o endpoint autentica, persiste o payload
/// BRUTO e responde rápido. A diferença é que aqui o processamento é síncrono
/// (o volume é baixo e o efeito - liberar ou bloquear acesso - precisa valer
/// imediatamente). `externalId` único garante que a reentrega do gateway, que
/// acontece sempre que ele não recebe 200, não aplique o mesmo efeito duas vezes.
model BillingEvent {
  id      String @id @default(cuid())
  gateway String @default("asaas")

  /// id do evento no gateway (Asaas: `evt_...`). Único = idempotência.
  externalId String @unique
  type       String // PAYMENT_CONFIRMED, PAYMENT_OVERDUE, ...
  payload    Json

  status BillingEventStatus @default(RECEIVED)
  error  String?

  /// Conta afetada, quando foi possível resolvê-la. Nulo em evento órfão
  /// (cobrança criada direto no painel do gateway, por exemplo).
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@index([accountId])
  @@map("billing_events")
}

/// Consumo medido por conta, métrica e ciclo (`period` = 'YYYY-MM').
///
/// O plano é flat, mas mensagem de IA e consulta de bureau custam por unidade.
/// Sem este contador não existe cota, não existe cobrança de excedente e uma
/// única loja de alto volume pode consumir mais do que paga. O incremento é
/// atômico (upsert + increment), então rodadas concorrentes do worker não se
/// perdem.
model UsageCounter {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  metric UsageMetric
  period String // 'YYYY-MM' no fuso de faturamento (America/Sao_Paulo)
  used   Int         @default(0)

  updatedAt DateTime @updatedAt

  @@unique([accountId, metric, period])
  @@index([period])
  @@map("usage_counters")
}

/// Registro anti-fraude de CPFs que já usufruíram do trial gratuito.
/// O CPF NUNCA é gravado em texto claro: `cpfHash` (SHA-256 + pepper) garante a
/// unicidade sem reversibilidade; `cpfSealed` guarda o CPF cifrado (AES-256-GCM)
/// só para uso administrativo/antifraude. A linha PERSISTE mesmo se a conta for
/// removida (accountId vira NULL) - o bloqueio do CPF é permanente.
model TrialCpfRegistry {
  id        String   @id @default(cuid())
  cpfHash   String   @unique
  cpfSealed Json? // { iv, tag, data } - payload cifrado
  accountId String?  @unique
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  usedAt    DateTime @default(now())

  @@index([cpfHash])
  @@map("trial_cpf_registry")
}

/// Prova de aceite dos documentos jurídicos (Termos de Uso + DPA + AUP + SLA,
/// aceitos como bloco único no cadastro) - ver
/// legal/07-CONTROLE-DE-VERSOES-E-REGISTRO-DE-ACEITE.md.
///
/// Somente inserção: nunca é atualizada nem apagada - um novo aceite (ex.:
/// re-aceite por versão nova) gera uma linha nova, não sobrescreve a anterior.
/// Sobrevive ao expurgo de retenção e ao encerramento da conta por ser prova
/// de relação contratual.
model TermsAcceptance {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  /// Hoje só existe 'terms' (o bloco único aceito no cadastro do trial). Um
  /// código por documento deixa a tabela pronta para aceites separados
  /// (ex.: consentimento de crédito) sem migration nova.
  documentCode    String
  documentVersion String
  /// 'signup' | 'checkout' | 'reacceptance' | 'plan-change'
  context         String

  ip         String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@index([accountId])
  @@index([userId])
  @@map("terms_acceptances")
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULOS FUTUROS (placeholders - NÃO implementados no MVP)
/// Módulo de Estoque / Garagem Digital - inventário de veículos da loja.
model Vehicle {
  id   String      @id @default(cuid())
  type VehicleType @default(CAR)

  /// Conta (tenant) dona do veículo. Nullable apenas por compatibilidade de
  /// migração - a aplicação sempre popula (scripts/backfill-storefronts.ts
  /// vincula o estoque pré-existente à conta default). É a chave de isolamento
  /// da vitrine pública: um lojista nunca vê/expõe o estoque de outro.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  // identificação
  brand           String // marca
  model           String
  version         String?
  yearFabrication Int
  yearModel       Int
  color           String?
  fuel            String? // Flex, Gasolina, Diesel, Etanol, Elétrico, Híbrido, GNV
  km              Int     @default(0)
  plate           String? // única DENTRO da conta (ver @@unique abaixo)
  chassi          String?
  renavam         String?

  // precificação (Decimal para integridade financeira nos relatórios futuros)
  fipePrice Decimal? @db.Decimal(12, 2) // informativo (tabela FIPE)
  costPrice Decimal? @db.Decimal(12, 2) // quanto a loja pagou
  salePrice Decimal  @db.Decimal(12, 2) // valor anunciado

  status      VehicleSaleStatus @default(PREPARING)
  optionals   Json              @default("[]") // string[] de itens/acessórios
  notes       String?
  description String? // texto de anúncio (gerado pelo co-piloto de IA, editável)

  /// Vitrine pública: exibir este veículo no site da loja (o lojista pode
  /// esconder unidades pontuais) e destacá-lo no topo da página.
  showOnSite Boolean @default(true) @map("show_on_site")
  featured   Boolean @default(false)

  /// ids do anúncio em cada plataforma - casa com Ticket.vehicle_ref_external
  /// no plano de migração (backfill futuro liga tickets a veículos por aqui).
  externalRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos           VehiclePhoto[]
  costs            VehicleCost[]
  financialEntries FinancialEntry[]
  fiscalInvoices   FiscalInvoice[]

  /// Placa é única por conta, não globalmente: duas lojas diferentes podem ter
  /// registrado o mesmo veículo (consignado que trocou de pátio, por exemplo).
  @@unique([accountId, plate])
  @@index([accountId, status])
  @@index([status])
  @@index([type])
  @@index([brand])
  @@index([createdAt])
  @@map("vehicles")
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0) // ordem na galeria
  isCover   Boolean  @default(false) // foto principal/capa
  createdAt DateTime @default(now())

  @@index([vehicleId, position])
  @@map("vehicle_photos")
}

/// Histórico de gastos atrelados ao veículo (preparação, estética, documentação…).
model VehicleCost {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    String // Oficina, Estética, Documentação, Peças, Outros
  description String
  amount      Decimal  @db.Decimal(12, 2)
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([vehicleId, incurredAt])
  @@map("vehicle_costs")
}

/// Módulo Administrativo & Fiscal - lançamento do fluxo de caixa (a pagar/receber).
model FinancialEntry {
  id          String          @id @default(cuid())
  type        FinancialType
  status      FinancialStatus @default(PENDING)
  category    String // Combustível, Aluguel, Comissão, Preparação de Veículo, Venda...
  description String
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?

  vehicleId String? // vínculo opcional a um veículo do estoque
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, dueDate])
  @@index([status])
  @@map("financial_entries")
}

/// Nota fiscal emitida (NF-e de veículos / NFS-e de serviços). Emissão mockada:
/// a integração real com a SEFAZ/prefeitura substitui o serviço mantendo o schema.
model FiscalInvoice {
  id            String       @id @default(cuid())
  number        Int          @unique @default(autoincrement())
  kind          FiscalKind
  status        FiscalStatus @default(PROCESSING)
  accessKey     String? // chave de acesso de 44 dígitos (NF-e)
  recipientName String
  recipientDoc  String? // CPF/CNPJ do destinatário (somente dígitos)

  operationValue Decimal @db.Decimal(12, 2) // valor da operação
  taxBase        Decimal @db.Decimal(12, 2) // base de cálculo (margem, para usados)
  taxRate        Decimal @db.Decimal(5, 4) // alíquota aplicada
  taxAmount      Decimal @db.Decimal(12, 2) // imposto apurado
  taxLabel       String // explicação (ex.: "ICMS sobre a margem")

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  xml          String? // conteúdo XML mock
  rejectReason String?
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([kind, issuedAt])
  @@index([status])
  @@map("fiscal_invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRÓXIMO PASSO DE INTEGRAÇÃO (planejado - não neste módulo)
// ─────────────────────────────────────────────────────────────────────────────
// Ligar Ticket ⇄ Vehicle: migration adiciona `vehicleId String?` + FK em tickets;
// backfill casando Ticket.vehicle_ref_external.externalId com Vehicle.externalRefs;
// mantém vehicle_ref_external como histórico da origem.
//
// model SaleRecord { id, ticketId FK, vehicleId FK, sellerId FK, amount, soldAt }
// alimentará os relatórios de receita/conversão por vendedor.
